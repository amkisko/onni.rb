<figure class="my-4">
  <figcaption>
    <svg width="28" height="12" aria-hidden="true"><line x1="0" y1="6" x2="28" y2="6" stroke="#2563eb" stroke-width="3" /></svg>
    Enabled
    <svg width="28" height="12" aria-hidden="true"><line x1="0" y1="6" x2="28" y2="6" stroke="#c2410c" stroke-width="3" stroke-dasharray="6 4" /></svg>
    Disabled
    <p>Scale: 0 to <%= number_with_delimiter(chart.maximum) %> evaluations per <%= chart.hourly? ? "hour" : "day" %>.</p>
  </figcaption>
  <svg viewBox="40 8 752 216" width="100%" height="220" preserveAspectRatio="none" role="img" aria-labelledby="onni-hit-chart-title onni-hit-chart-description">
    <title id="onni-hit-chart-title">Enabled and disabled evaluations over time</title>
    <desc id="onni-hit-chart-description">A solid blue line shows enabled evaluations and a dashed orange line shows disabled evaluations. Exact counts are available in the table below.</desc>
    <% [24, 116, 208].each do |y| %>
      <line x1="56" y1="<%= y %>" x2="776" y2="<%= y %>" stroke="currentColor" stroke-opacity="0.2" vector-effect="non-scaling-stroke" />
    <% end %>
    <polyline points="<%= chart.points("enabled_hits") %>" fill="none" stroke="#2563eb" stroke-width="3" vector-effect="non-scaling-stroke" />
    <polyline points="<%= chart.points("disabled_hits") %>" fill="none" stroke="#c2410c" stroke-width="3" stroke-dasharray="6 4" vector-effect="non-scaling-stroke" />
  </svg>
  <p>
    <%= l(chart.hourly? ? chart.rows.first.fetch("period_start") : chart.rows.first.fetch("period_start").to_date, format: :short) %>
    to
    <%= l(chart.hourly? ? chart.rows.last.fetch("period_start") : chart.rows.last.fetch("period_start").to_date, format: :short) %>
    (UTC)
  </p>
</figure>
