<figure class="my-4">
  <figcaption class="flex flex-wrap gap-x-4 gap-y-2">
    <span class="inline-flex items-center gap-2">
      <svg width="28" height="12" aria-hidden="true"><line x1="0" y1="6" x2="28" y2="6" stroke="#2563eb" stroke-width="3" /></svg>
      Shown count
    </span>
    <span class="inline-flex items-center gap-2">
      <svg width="28" height="12" aria-hidden="true"><line x1="0" y1="6" x2="28" y2="6" stroke="#c2410c" stroke-width="3" stroke-dasharray="6 4" /></svg>
      Skip count
    </span>
  </figcaption>
  <svg viewBox="40 8 752 216" width="100%" height="220" preserveAspectRatio="none" role="img" aria-labelledby="onni-visibility-chart-title onni-visibility-chart-description">
    <title id="onni-visibility-chart-title">Shown and skipped evaluations over time</title>
    <desc id="onni-visibility-chart-description">A solid blue line shows shown evaluations and a dashed orange line shows skipped evaluations.</desc>
    <% [24, 116, 208].each do |y| %>
      <line x1="56" y1="<%= y %>" x2="776" y2="<%= y %>" stroke="currentColor" stroke-opacity="0.2" vector-effect="non-scaling-stroke" />
    <% end %>
    <polyline points="<%= chart.points("shown_count") %>" fill="none" stroke="#2563eb" stroke-width="3" vector-effect="non-scaling-stroke" />
    <polyline points="<%= chart.points("skip_count") %>" fill="none" stroke="#c2410c" stroke-width="3" stroke-dasharray="6 4" vector-effect="non-scaling-stroke" />
  </svg>
  <p>
    <%= l(chart.hourly? ? chart.rows.first.fetch("period_start") : chart.rows.first.fetch("period_start").to_date, format: :short) %>
    to
    <%= l(chart.hourly? ? chart.rows.last.fetch("period_start") : chart.rows.last.fetch("period_start").to_date, format: :short) %>
    (UTC), scale 0–<%= number_with_delimiter(chart.maximum) %>
  </p>
</figure>
