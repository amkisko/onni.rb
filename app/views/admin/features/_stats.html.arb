feature_path ||= helpers.onni_feature_path(flag.name)
range_form = Onni::HistoryForm.new(range: chart.range)

div do
  h2 "Evaluations", class: "text-lg font-bold text-gray-700 dark:text-gray-200 mb-4", id: "onni-visibility-history"

  active_admin_form_for(
    range_form,
    url: feature_path,
    method: :get
  ) do |f|
    f.inputs do
      f.input :range,
        as: :select,
        label: "History",
        collection: [["Last 24 hours", "24h"], ["Last 7 days", "7d"], ["Last 30 days", "30d"]],
        include_blank: false,
        input_html: {name: "range", id: "range"}
    end
    f.actions do
      f.action :submit, label: "Show"
    end
  end

  totals = [
    {
      "shown_count" => helpers.number_with_delimiter(chart.shown_count),
      "skip_count" => helpers.number_with_delimiter(chart.skip_count),
      "share" => chart.shown_share ? helpers.number_to_percentage(chart.shown_share * 100, precision: 1) : "No data"
    }
  ]
  div class: "paginated-collection mb-4" do
    div class: "paginated-collection-contents" do
      div class: "index-as-table" do
        table_for totals do
          column("Shown count") { |row| span row.fetch("shown_count"), "data-onni-shown-count": true }
          column("Skip count") { |row| span row.fetch("skip_count"), "data-onni-skip-count": true }
          column("Shown share") { |row| span row.fetch("share"), "data-onni-shown-share": true }
        end
      end
    end
  end

  if chart.shown_share.nil?
    para role: "status", class: "my-4" do
      text_node "No recorded evaluations in this window."
    end
  else
    text_node helpers.render(partial: "admin/features/chart", locals: {chart: chart})
  end

  details class: "mt-4" do
    summary "Counts by #{chart.hourly? ? "hour" : "day"} (UTC)"
    div class: "paginated-collection mt-4" do
      div class: "paginated-collection-contents" do
        div class: "index-as-table" do
          table_for chart.rows do
            column(chart.hourly? ? "Hour" : "Day") do |row|
              helpers.l(
                chart.hourly? ? row.fetch("period_start") : row.fetch("period_start").to_date,
                format: :short
              )
            end
            column("Shown count") { |row| helpers.number_with_delimiter(row.fetch("shown_count")) }
            column("Skip count") { |row| helpers.number_with_delimiter(row.fetch("skip_count")) }
          end
        end
      end
    end
  end
end
