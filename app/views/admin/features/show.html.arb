flag = assigns.fetch(:flag)
chart = assigns.fetch(:visibility_chart)
variants = flag.variants
feature_path = helpers.onni_feature_path(flag.name)
rollout_form = Onni::RolloutForm.new(level: flag.level)

div class: "main-content-container" do
  div class: "space-y-10" do
    if flag.description.present?
      para do
        text_node flag.description
      end
    end

    div do
      h2 "Overview", class: "text-lg font-bold text-gray-700 dark:text-gray-200 mb-4"
      attributes_table_for(flag) do
        row("Status") { status_tag(flag.power_state.to_s.capitalize) }
        row("Expires") do
          if flag.expires_summary
            span flag.expires_summary, title: flag.expires_full, "data-onni-expires": true
          else
            span "—"
          end
        end
        row("Sample rate") do
          if !Onni.configuration.stats_enabled
            text_node "off"
          elsif Array(Onni.configuration.stats_ignore).any? { |key| key.to_s == flag.name }
            text_node "ignored"
          else
            text_node Onni.configuration.stats_sample_rate
          end
        end
      end
    end

    div do
      h2 "Audience", class: "text-lg font-bold text-gray-700 dark:text-gray-200 mb-4"
      attributes_table_for(flag) do
        row("Type") { flag.type.capitalize }
        case flag.type
        when "percentage"
          row("Level") { flag.level }
        when "group"
          row("Groups") { flag.groups.join(", ").presence || "None" }
        when "actors"
          row("Actors") { flag.actors.size }
        end
      end
    end

    if %w[percentage group experiment].include?(flag.type)
      div do
        h2 "Rollout", class: "text-lg font-bold text-gray-700 dark:text-gray-200 mb-4"
        active_admin_form_for(
          rollout_form,
          url: helpers.admin_features_update_feature_path(key: flag.name),
          method: :post
        ) do |f|
          f.inputs do
            if flag.type == "percentage"
              f.input :level,
                as: :number,
                label: "Level (0-100)",
                input_html: {min: 0, max: 100, name: "level", id: "level"}
            end
            if flag.type == "group"
              f.input :group_name,
                as: :select,
                collection: Onni::Group.names,
                include_blank: true,
                input_html: {name: "group_name", id: "group_name"}
              f.input :group_action,
                as: :select,
                collection: [["Add group", "visible"], ["Remove group", "drop"]],
                include_blank: "Action",
                input_html: {name: "group_action", id: "group_action"}
            end
            if flag.type == "experiment"
              variants.each_with_index do |(name, weight), index|
                f.input :variant_weight,
                  as: :number,
                  label: "Variant #{name}",
                  input_html: {min: 0, value: weight, name: "variants[#{name}]", id: "variant_#{index}"}
              end
            end
          end
          f.actions do
            f.action :submit, label: "Save"
          end
        end
      end
    end

    text_node helpers.render(
      partial: "admin/features/stats",
      locals: {chart: chart, flag: flag, feature_path: feature_path}
    )

    para do
      text_node helpers.link_to("Back to flags", helpers.admin_features_path, class: "action-item-button")
    end
  end
end
