<% flag = @flag %>
<% variants = flag.variants %>
<% enabled = flag.enabled?(record_stats: false) %>
<div>
  <h2 class="text-xl font-semibold mb-2"><%= flag.name %></h2>
  <% if flag.description.present? %>
    <p class="mb-3"><%= flag.description %></p>
  <% end %>

  <table class="mb-4">
    <tbody>
      <tr>
        <th scope="row">Status</th>
        <td><%= enabled ? "Enabled" : "Disabled" %></td>
        <th scope="row">Expires</th>
        <td>
          <% if flag.expires_summary %>
            <span title="<%= flag.expires_full %>" data-onni-expires><%= flag.expires_summary %></span>
          <% else %>
            —
          <% end %>
        </td>
        <th scope="row">Sample rate</th>
        <td>
          <% if !Onni.configuration.stats_enabled %>
            off
          <% elsif Array(Onni.configuration.stats_ignore).any? { |key| key.to_s == flag.name } %>
            ignored
          <% else %>
            <%= Onni.configuration.stats_sample_rate %>
          <% end %>
        </td>
      </tr>
    </tbody>
  </table>

  <h3 class="font-semibold mb-2">Gates</h3>
  <% if flag.gates.empty? %>
    <p class="mb-4">None</p>
  <% else %>
    <table class="mb-4">
      <thead>
        <tr>
          <th scope="col">Key</th>
          <th scope="col">Value</th>
        </tr>
      </thead>
      <tbody>
        <% flag.gates.each do |gate| %>
          <tr>
            <td><code><%= gate["key"] %></code></td>
            <td><code><%= gate["value"] %></code></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <%= form_with url: admin_features_update_feature_path(key: flag.name), method: :post, local: true, class: "mb-6 space-y-3" do %>
    <div>
      <label>Percentage of actors (0-100)</label>
      <%= number_field_tag :percentage, flag.gates.find { |gate| gate["key"] == "percentage_of_actors" }&.fetch("value", nil), min: 0, max: 100 %>
    </div>
    <div>
      <label>Group</label>
      <%= select_tag :group_name, options_for_select(Onni::Group.names), include_blank: true %>
      <%= select_tag :group_action, options_for_select([%w[Enable enable], %w[Disable disable]]), include_blank: "Action" %>
    </div>
    <div>
      <label>A/B variants (name and weight)</label>
      <div class="flex gap-2 items-end">
        <div>
          <label for="variant_control">control</label>
          <%= number_field_tag "variants[control]", variants["control"], min: 0, max: 100, id: "variant_control" %>
        </div>
        <div>
          <label for="variant_treatment">treatment</label>
          <%= number_field_tag "variants[treatment]", variants["treatment"], min: 0, max: 100, id: "variant_treatment" %>
        </div>
      </div>
    </div>
    <%= submit_tag "Save", class: "button" %>
  <% end %>

  <%= render partial: "admin/features/stats", locals: { chart: @hit_chart, flag: flag } %>

  <p class="mt-4"><%= link_to "Back to features", admin_features_path %></p>
</div>
